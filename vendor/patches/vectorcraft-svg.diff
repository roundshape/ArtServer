+/// The CSS weight of face style `style`. Japanese faces (Hiragino, Morisawa…) name their weights
+/// W0–W9: each is its number × 100 (W3 300, W6 600; W0 and W1 100). Other names go through
+/// `style_weight`, which reads English words only and would make every W style 400 (ArtServer
+/// patch: vendor/README.md).
+fn style_css_weight(style: &str) -> f32 {
+    let w_number = style.split(|c: char| c.is_whitespace() || c == '-' || c == '_').find_map(|part| match part.as_bytes() {
+        [b'W' | b'w', d @ b'0'..=b'9'] => Some(f32::from(d - b'0')),
+        _ => None,
+    });
+    match w_number {
+        Some(n) => (n * 100.0).max(100.0),
+        None => vectorcraft_text::style_weight(style),
+    }
+}
